# Criptofolio Backend Environment Configuration

# -----------------------------------------------------------------------------
# DATABASE PATHS
# -----------------------------------------------------------------------------

# All three databases — the SQLite ledger (criptofolio_ledger.db), the SQLite vault
# (criptofolio.db) and the DuckDB analytical engine (fiscal.duckdb) — plus the historical-price
# Parquet tree are resolved from the workspace root by @criptofolio/database. No path variable is
# required, and none should be relative to the working directory: the same relative value names a
# different file per directory a process starts in, which silently splits the ledger in two.

# Move all of them at once (a container volume, say). Absolute, or relative to the workspace root.
# CRIPTOFOLIO_DATA_DIR=/var/lib/criptofolio

# Per-file overrides, for pointing one database somewhere else. Absolute paths recommended; a
# relative value is anchored to the data root, never to the working directory.
# LEDGER_DB_PATH=
# VAULT_DB_PATH=
# DUCKDB_PATH=
# PARQUET_DATA_PATH=

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------

# Port for the Hono server to listen on
PORT=3001

# Enable mock mode (bypasses database and real APIs)
MOCK_MODE=false
